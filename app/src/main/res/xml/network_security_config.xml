<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is only ever tried against home-network (LAN) addresses or an
     address you type in yourself; QuickConnect and internet routes use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
